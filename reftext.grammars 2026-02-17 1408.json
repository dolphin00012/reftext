{"scopeName": "source.reftext",   "foldingStartMarker": "^#", "patterns": [
{"name": "out.pinkline.reftext",  "match": "^#.*$" },
{"name": "out.dotword.reftext",   "match": "^ {0,2}\\w+-?-?(\\w+)?\\.|^\\* |^\\*" },
{"name": "out.asterisk.reftext",  "match": "\\*[^*]+\\*" },
{"name": "out.greenline.reftext", "match": "^//.*$" },
{"name": "in.reftext",            "begin": "\\{", "end": "\\}", "patterns": [
{"name": "in.longdate.reftext",   "match": "\\d{4}-\\d{2}-\\d{2}\\s\\d{4}" },
{"name": "in.shortdate.reftext",  "match": "\\b\\d{4}\\b" },
{"name": "in.comma.reftext",      "match": ",\\s" },
{"name": "in.note.reftext",       "match": "." }
]}]}